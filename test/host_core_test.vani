// Host-runnable validation for tls13's core-only (no self-test
// function itself, core.vani deps not lib.vani) subset.
//
// `vanic run` (LLVM JIT) cannot execute this directly -- core.vani
// carries the heap-pointer API's own `extern "C" fn buf_read_byte/
// buf_write_byte` declarations (unimplemented here by design; a real
// consumer supplies them), and the JIT needs every module-level
// extern to resolve even if this file's own main() never calls them.
// Verify via LLVM-IR emission -> llc -> cc -> native run instead:
//   vanic emit test/host_core_test.vani --backend=llvm -o /tmp/t.ll
//   llc -filetype=obj /tmp/t.ll -o /tmp/t.o
//   cc -no-pie /tmp/t.o <a .c file defining buf_read_byte/buf_write_byte> -o /tmp/t -lm
//   /tmp/t
// (--backend=c is a dead end too, blocked by the unrelated pre-
// existing struct-array-field bug, gap #5 in vani-compiler/docs/
// DHRUVAOS_ERGONOMICS_TODO.md.)
//
// Reproduces src/lib.vani's own tls13_self_test() body directly --
// proves core.vani alone (no lib.vani) is sufficient to run the full
// handshake + app-data round trip, not just that it parses. The
// motivating consumer is DhruvaOS's Pi 1 kernel (round 174), which
// vendors core.vani specifically to avoid colliding with its own
// already-defined sha256_self_test/x25519_self_test/etc.

use "../src/core.vani";

fn main() -> i64 {
  let ok: i64 = 1;

  let zero32: [u8; 32] = [0 as u8; 32];
  let empty_transcript: [u8; 1024] = [0 as u8; 1024];

  let client_random: [u8; 32] = [
    0x01 as u8, 0x04 as u8, 0x07 as u8, 0x0a as u8, 0x0d as u8, 0x10 as u8, 0x13 as u8, 0x16 as u8,
    0x19 as u8, 0x1c as u8, 0x1f as u8, 0x22 as u8, 0x25 as u8, 0x28 as u8, 0x2b as u8, 0x2e as u8,
    0x31 as u8, 0x34 as u8, 0x37 as u8, 0x3a as u8, 0x3d as u8, 0x40 as u8, 0x43 as u8, 0x46 as u8,
    0x49 as u8, 0x4c as u8, 0x4f as u8, 0x52 as u8, 0x55 as u8, 0x58 as u8, 0x5b as u8, 0x5e as u8
  ];
  let server_random: [u8; 32] = [
    0x02 as u8, 0x07 as u8, 0x0c as u8, 0x11 as u8, 0x16 as u8, 0x1b as u8, 0x20 as u8, 0x25 as u8,
    0x2a as u8, 0x2f as u8, 0x34 as u8, 0x39 as u8, 0x3e as u8, 0x43 as u8, 0x48 as u8, 0x4d as u8,
    0x52 as u8, 0x57 as u8, 0x5c as u8, 0x61 as u8, 0x66 as u8, 0x6b as u8, 0x70 as u8, 0x75 as u8,
    0x7a as u8, 0x7f as u8, 0x84 as u8, 0x89 as u8, 0x8e as u8, 0x93 as u8, 0x98 as u8, 0x9d as u8
  ];
  let client_priv: [u8; 32] = [
    0x03 as u8, 0x0a as u8, 0x11 as u8, 0x18 as u8, 0x1f as u8, 0x26 as u8, 0x2d as u8, 0x34 as u8,
    0x3b as u8, 0x42 as u8, 0x49 as u8, 0x50 as u8, 0x57 as u8, 0x5e as u8, 0x65 as u8, 0x6c as u8,
    0x73 as u8, 0x7a as u8, 0x81 as u8, 0x88 as u8, 0x8f as u8, 0x96 as u8, 0x9d as u8, 0xa4 as u8,
    0xab as u8, 0xb2 as u8, 0xb9 as u8, 0xc0 as u8, 0xc7 as u8, 0xce as u8, 0xd5 as u8, 0xdc as u8
  ];
  let server_priv: [u8; 32] = [
    0x04 as u8, 0x0f as u8, 0x1a as u8, 0x25 as u8, 0x30 as u8, 0x3b as u8, 0x46 as u8, 0x51 as u8,
    0x5c as u8, 0x67 as u8, 0x72 as u8, 0x7d as u8, 0x88 as u8, 0x93 as u8, 0x9e as u8, 0xa9 as u8,
    0xb4 as u8, 0xbf as u8, 0xca as u8, 0xd5 as u8, 0xe0 as u8, 0xeb as u8, 0xf6 as u8, 0x01 as u8,
    0x0c as u8, 0x17 as u8, 0x22 as u8, 0x2d as u8, 0x38 as u8, 0x43 as u8, 0x4e as u8, 0x59 as u8
  ];
  let server_id_priv: [u8; 32] = [
    0x05 as u8, 0x12 as u8, 0x1f as u8, 0x2c as u8, 0x39 as u8, 0x46 as u8, 0x53 as u8, 0x60 as u8,
    0x6d as u8, 0x7a as u8, 0x87 as u8, 0x94 as u8, 0xa1 as u8, 0xae as u8, 0xbb as u8, 0xc8 as u8,
    0xd5 as u8, 0xe2 as u8, 0xef as u8, 0xfc as u8, 0x09 as u8, 0x16 as u8, 0x23 as u8, 0x30 as u8,
    0x3d as u8, 0x4a as u8, 0x57 as u8, 0x64 as u8, 0x71 as u8, 0x7e as u8, 0x8b as u8, 0x98 as u8
  ];

  let basepoint: [u8; 32] = tls_basepoint32();
  let client_pub: [u8; 32] = x25519_scalarmult(ref client_priv, ref basepoint);
  let server_pub: [u8; 32] = x25519_scalarmult(ref server_priv, ref basepoint);

  let shared_c: [u8; 32] = x25519_scalarmult(ref client_priv, ref server_pub);
  let shared_s: [u8; 32] = x25519_scalarmult(ref server_priv, ref client_pub);
  if tls_bytes_equal32(ref shared_c, ref shared_s) != 1 { ok = 0; }

  let server_id_pub: [u8; 32] = ed25519_secret_to_public(ref server_id_priv);

  // Shared scratch reused across every message-build + round-trip-
  // verify phase below.
  let msg_buf: [u8; 512] = [0 as u8; 512];
  let rec_buf: [u8; 512] = [0 as u8; 512];
  let recv_len: i64 = 0;
  let transcript: [u8; 1024] = [0 as u8; 1024];
  let t_len: i64 = 0;
  let ti: i64 = 0;

  // --- ClientHello ---
  let ch_len: i64 = tls_build_client_hello(ref client_random, ref client_pub, mut ref msg_buf);
  ti = 0;
  while ti < ch_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + ch_len;

  // --- ServerHello ---
  let sh_len: i64 = tls_build_server_hello(ref server_random, ref server_pub, mut ref msg_buf);
  ti = 0;
  while ti < sh_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + sh_len;
  let t_len_sh: i64 = t_len;

  // --- Key schedule through handshake traffic secrets ---
  let early_secret: [u8; 32] = tls_hkdf_extract(ref zero32, ref zero32);
  let derived_es: [u8; 32] = tls_derive_secret(ref early_secret, "derived", ref empty_transcript, 0);
  let handshake_secret: [u8; 32] = tls_hkdf_extract(ref derived_es, ref shared_c);

  let c_hs_traffic: [u8; 32] = tls_derive_secret(ref handshake_secret, "c hs traffic", ref transcript, t_len_sh);
  let s_hs_traffic: [u8; 32] = tls_derive_secret(ref handshake_secret, "s hs traffic", ref transcript, t_len_sh);

  let c_hs_keys: TlsTrafficKeys = tls_derive_traffic_keys(ref c_hs_traffic);
  let c_hs_key: [u8; 32] = c_hs_keys.key;
  let c_hs_iv: [u8; 12] = c_hs_keys.iv;
  let s_hs_keys: TlsTrafficKeys = tls_derive_traffic_keys(ref s_hs_traffic);
  let s_hs_key: [u8; 32] = s_hs_keys.key;
  let s_hs_iv: [u8; 12] = s_hs_keys.iv;

  // DEBUG bisection: return early right after key-schedule derivation,
  // before any message building or record-layer encrypt/decrypt.

  // --- EncryptedExtensions: build, transcript, round-trip verify ---
  let ee_len: i64 = tls_build_encrypted_extensions(mut ref msg_buf);
  ti = 0;
  while ti < ee_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + ee_len;

  let enc_ee: TlsEncryptResult = tls_encrypt_record(ref s_hs_key, ref s_hs_iv, 0, ref msg_buf, ee_len, 22);
  rec_buf = enc_ee.rec;
  recv_len = enc_ee.span_len;
  let dec_ee: TlsDecryptResult = tls_decrypt_record(ref s_hs_key, ref s_hs_iv, 0, ref rec_buf, recv_len, 22);
  if (dec_ee.ok != 1) || (dec_ee.span_len != ee_len) || (tls_bytes_equal512(ref dec_ee.content, ref msg_buf, ee_len) != 1) { ok = 0; }

  // --- Certificate: build, transcript, cert_transcript_hash, round-trip verify ---
  let cert_len: i64 = tls_build_certificate(ref server_id_pub, mut ref msg_buf);
  ti = 0;
  while ti < cert_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + cert_len;
  let t_len_cert: i64 = t_len;

  let cert_transcript_hash: [u8; 32] = tls_hash_transcript(ref transcript, t_len_cert);

  let enc_cert: TlsEncryptResult = tls_encrypt_record(ref s_hs_key, ref s_hs_iv, 1, ref msg_buf, cert_len, 22);
  rec_buf = enc_cert.rec;
  recv_len = enc_cert.span_len;
  let dec_cert: TlsDecryptResult = tls_decrypt_record(ref s_hs_key, ref s_hs_iv, 1, ref rec_buf, recv_len, 22);
  if (dec_cert.ok != 1) || (dec_cert.span_len != cert_len) || (tls_bytes_equal512(ref dec_cert.content, ref msg_buf, cert_len) != 1) { ok = 0; }

  // --- CertificateVerify: cv_content built into msg_buf (cert no
  // longer needed after its own check above), signed, then msg_buf
  // is overwritten with the actual CertificateVerify message built
  // from that signature (cv_content itself no longer needed once
  // cv_sig is computed). ---
  let cv_content_len: i64 = tls_certverify_signed_content(ref cert_transcript_hash, mut ref msg_buf);
  let cv_sig: [u8; 64] = ed25519_sign(ref server_id_priv, ref msg_buf, cv_content_len);
  let cv_len: i64 = tls_build_certificate_verify(ref cv_sig, mut ref msg_buf);
  ti = 0;
  while ti < cv_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + cv_len;
  let t_len_cv: i64 = t_len;

  let enc_cv: TlsEncryptResult = tls_encrypt_record(ref s_hs_key, ref s_hs_iv, 2, ref msg_buf, cv_len, 22);
  rec_buf = enc_cv.rec;
  recv_len = enc_cv.span_len;
  let dec_cv: TlsDecryptResult = tls_decrypt_record(ref s_hs_key, ref s_hs_iv, 2, ref rec_buf, recv_len, 22);
  if (dec_cv.ok != 1) || (dec_cv.span_len != cv_len) || (tls_bytes_equal512(ref dec_cv.content, ref msg_buf, cv_len) != 1) { ok = 0; }

  // --- Server Finished ---
  let s_verify_data: [u8; 32] = tls_finished_verify_data(ref s_hs_traffic, ref transcript, t_len_cv);
  let s_fin_len: i64 = tls_build_finished(ref s_verify_data, mut ref msg_buf);
  ti = 0;
  while ti < s_fin_len { transcript[t_len + ti] = msg_buf[ti]; ti = ti + 1; }
  t_len = t_len + s_fin_len;
  let t_len_s_fin: i64 = t_len;

  let enc_s_fin: TlsEncryptResult = tls_encrypt_record(ref s_hs_key, ref s_hs_iv, 3, ref msg_buf, s_fin_len, 22);
  rec_buf = enc_s_fin.rec;
  recv_len = enc_s_fin.span_len;
  let dec_s_fin: TlsDecryptResult = tls_decrypt_record(ref s_hs_key, ref s_hs_iv, 3, ref rec_buf, recv_len, 22);
  if (dec_s_fin.ok != 1) || (dec_s_fin.span_len != s_fin_len) || (tls_bytes_equal512(ref dec_s_fin.content, ref msg_buf, s_fin_len) != 1) { ok = 0; }

  // Tamper check -- rec_buf/recv_len still hold the just-built s_fin
  // record (nothing overwrote them since the round-trip check above).
  let tampered: [u8; 512] = rec_buf;
  tampered[5] = tampered[5] ^ (0xff as u8);
  let dec_tampered: TlsDecryptResult = tls_decrypt_record(ref s_hs_key, ref s_hs_iv, 3, ref tampered, recv_len, 22);
  if dec_tampered.ok == 1 { ok = 0; }

  // --- Client verifies CertificateVerify against the (self-test-
  // known) server identity public key -- RFC 7250 pinned-key trust.
  // cert_transcript_hash is still held from the Certificate phase
  // above; msg_buf (currently holding s_fin, no longer needed) is
  // reused to recompute cv_content fresh. ---
  let recomputed_cv_content_len: i64 = tls_certverify_signed_content(ref cert_transcript_hash, mut ref msg_buf);
  if ed25519_verify(ref server_id_pub, ref msg_buf, recomputed_cv_content_len, ref cv_sig) != 1 { ok = 0; }

  // --- Client verifies server Finished ---
  let s_verify_data_check: [u8; 32] = tls_finished_verify_data(ref s_hs_traffic, ref transcript, t_len_cv);
  if tls_bytes_equal32(ref s_verify_data_check, ref s_verify_data) != 1 { ok = 0; }

  // --- Client Finished ---
  let c_verify_data: [u8; 32] = tls_finished_verify_data(ref c_hs_traffic, ref transcript, t_len_s_fin);
  let c_fin_len: i64 = tls_build_finished(ref c_verify_data, mut ref msg_buf);

  let enc_c_fin: TlsEncryptResult = tls_encrypt_record(ref c_hs_key, ref c_hs_iv, 0, ref msg_buf, c_fin_len, 22);
  rec_buf = enc_c_fin.rec;
  recv_len = enc_c_fin.span_len;
  let dec_c_fin: TlsDecryptResult = tls_decrypt_record(ref c_hs_key, ref c_hs_iv, 0, ref rec_buf, recv_len, 22);
  if (dec_c_fin.ok != 1) || (dec_c_fin.span_len != c_fin_len) || (tls_bytes_equal512(ref dec_c_fin.content, ref msg_buf, c_fin_len) != 1) { ok = 0; }

  let c_verify_data_check: [u8; 32] = tls_finished_verify_data(ref c_hs_traffic, ref transcript, t_len_s_fin);
  if tls_bytes_equal32(ref c_verify_data_check, ref c_verify_data) != 1 { ok = 0; }

  // --- Application traffic secrets (Master Secret derived from the
  // SAME Handshake Secret, transcript through server Finished only). ---
  let derived_hs: [u8; 32] = tls_derive_secret(ref handshake_secret, "derived", ref empty_transcript, 0);
  let master_secret: [u8; 32] = tls_hkdf_extract(ref derived_hs, ref zero32);

  let c_ap_traffic: [u8; 32] = tls_derive_secret(ref master_secret, "c ap traffic", ref transcript, t_len_s_fin);
  let s_ap_traffic: [u8; 32] = tls_derive_secret(ref master_secret, "s ap traffic", ref transcript, t_len_s_fin);

  let c_ap_keys: TlsTrafficKeys = tls_derive_traffic_keys(ref c_ap_traffic);
  let c_ap_key: [u8; 32] = c_ap_keys.key;
  let c_ap_iv: [u8; 12] = c_ap_keys.iv;
  let s_ap_keys: TlsTrafficKeys = tls_derive_traffic_keys(ref s_ap_traffic);
  let s_ap_key: [u8; 32] = s_ap_keys.key;
  let s_ap_iv: [u8; 12] = s_ap_keys.iv;

  // --- Application data round trip, both directions ---
  let client_msg_str: Str = "dhruva-tls-client-hello-app-data";
  let client_msg_len: i64 = str_len_bytes(client_msg_str);
  ti = 0;
  while ti < client_msg_len { msg_buf[ti] = str_byte_at(client_msg_str, ti) as u8; ti = ti + 1; }

  let enc_c_msg: TlsEncryptResult = tls_encrypt_record(ref c_ap_key, ref c_ap_iv, 0, ref msg_buf, client_msg_len, 23);
  rec_buf = enc_c_msg.rec;
  recv_len = enc_c_msg.span_len;
  let dec_c_msg: TlsDecryptResult = tls_decrypt_record(ref c_ap_key, ref c_ap_iv, 0, ref rec_buf, recv_len, 23);
  if (dec_c_msg.ok != 1) || (dec_c_msg.span_len != client_msg_len) || (tls_bytes_equal512(ref dec_c_msg.content, ref msg_buf, client_msg_len) != 1) { ok = 0; }

  let server_reply_str: Str = "dhruva-tls-server-reply-app-data";
  let server_reply_len: i64 = str_len_bytes(server_reply_str);
  ti = 0;
  while ti < server_reply_len { msg_buf[ti] = str_byte_at(server_reply_str, ti) as u8; ti = ti + 1; }

  let enc_s_reply: TlsEncryptResult = tls_encrypt_record(ref s_ap_key, ref s_ap_iv, 0, ref msg_buf, server_reply_len, 23);
  rec_buf = enc_s_reply.rec;
  recv_len = enc_s_reply.span_len;
  let dec_s_reply: TlsDecryptResult = tls_decrypt_record(ref s_ap_key, ref s_ap_iv, 0, ref rec_buf, recv_len, 23);
  if (dec_s_reply.ok != 1) || (dec_s_reply.span_len != server_reply_len) || (tls_bytes_equal512(ref dec_s_reply.content, ref msg_buf, server_reply_len) != 1) { ok = 0; }


  if ok == 1 {
    print "tls13 core: full handshake + app-data round trip via core.vani PASS";
  }
  return 1 - ok;
}
