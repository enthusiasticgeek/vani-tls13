// Host-runnable validation for tls13's array API + tls13_self_test().
//
// `vanic run test/host_test.vani` (LLVM JIT) no longer works as of
// round 174: src/lib.vani now also carries the heap-pointer API's
// `extern "C" fn buf_read_byte/buf_write_byte` declarations
// (unimplemented here by design), and the JIT needs every module-
// level extern to resolve even though main() below never calls them.
// `--backend=c` is a dead end too (pre-existing struct-array-field
// bug, gap #5 in vani-compiler/docs/DHRUVAOS_ERGONOMICS_TODO.md).
// Verify via LLVM-IR emission -> llc -> cc -> native run instead, same
// as test/host_core_test.vani's own header comment documents.

use "../src/lib.vani";

fn main() -> i64 {
  assert tls13_self_test() == 1;
  print "tls13: TLS 1.3 handshake + app data round trip self-test PASS";
  return 0;
}
